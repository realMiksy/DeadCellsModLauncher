<Window x:Class="DcmmInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dead Cells Mod Launcher"
        Height="792" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="appicon.ico">

    <Border CornerRadius="14" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource BgTop}" Offset="0"/>
                <GradientStop Color="{StaticResource BgBottom}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar (draggable) -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="44" Background="Transparent" MouseDown="TitleBar_MouseDown">
                <TextBlock Text="Dead Cells Mod Launcher" Foreground="{StaticResource TextBrush}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="MinBtn" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="40" Height="30"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource SubtleTextBrush}"
                            Cursor="Hand" Click="Min_Click"/>
                    <Button x:Name="CloseBtn" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="40" Height="30"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource SubtleTextBrush}"
                            Cursor="Hand" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Header with original pixel-torch emblem (all vector, no copyrighted art) -->
            <Grid Grid.Row="1" Margin="30,10,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Emblem: the full app icon (same as the .exe / taskbar icon) -->
                <Image Grid.Column="0" Source="logo.png" Width="60" Height="60" Margin="0,0,16,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="DEAD CELLS MOD LAUNCHER" Foreground="{StaticResource TextBrush}"
                               FontSize="23" FontWeight="Bold" FontFamily="Consolas"/>
                    <TextBlock Text="co-op mod  &#x2022;  launcher &#x2022; installer &#x2022; updater" Foreground="{StaticResource AccentBrush}"
                               FontSize="12.5" FontFamily="Consolas" Margin="1,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- thin ember divider under the header -->
            <Border Grid.Row="1" Height="2" VerticalAlignment="Bottom" Margin="30,0,30,-8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0054C8E8" Offset="0"/>
                        <GradientStop Color="#FF54C8E8" Offset="0.5"/>
                        <GradientStop Color="#0054C8E8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="2" Margin="30,22,30,0" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- DCCM status card -->
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,12"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DccmIcon" Grid.Column="0" Text="&#x25CF;"
                                       FontSize="20" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Core Modding API (DCCM)" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="DccmStatus" Text="Checking..." Foreground="{StaticResource SubtleTextBrush}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="DiagnosticsBtn" Content="Diagnostics" Style="{StaticResource GhostButton}"
                                        Padding="10,6" Margin="0,0,8,0" Click="Diagnostics_Click"/>
                                <Button x:Name="DccmGuideBtn" Content="Guide" Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" Visibility="Collapsed" Click="DccmGuide_Click"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="34,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Automatic setup" Foreground="{StaticResource TextBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="Steam hosting is enabled automatically for Steam installs; standalone installs use LAN / port forwarding."
                                           Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock x:Name="PrereqStatus" Text="Prerequisites: checking..."
                                           Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button x:Name="DccmInstallBtn" Grid.Column="1" Content="Install / Repair DCCM" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,7" Click="DccmInstall_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Install location card -->
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16,14"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Install location" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14"/>
                            <Button x:Name="BrowseBtn" Content="Change..." Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" Padding="12,6" Click="Browse_Click"/>
                        </Grid>
                        <Border Background="#FF11151C" CornerRadius="7" Padding="12,10" Margin="0,10,0,0">
                            <TextBlock x:Name="PathText" Text="Detecting Dead Cells..." Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="12.5" FontFamily="Consolas" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock x:Name="PathHint" Text="" Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5" Margin="2,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Version line + persistent update indicator -->
                <Grid Grid.Row="2" Margin="4,16,0,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Installed:" Foreground="{StaticResource SubtleTextBrush}" FontSize="12.5"/>
                        <TextBlock x:Name="InstalledVer" Text="—" Foreground="{StaticResource TextBrush}" FontSize="12.5" Margin="6,0,20,0"/>
                        <TextBlock Text="Latest:" Foreground="{StaticResource SubtleTextBrush}" FontSize="12.5"/>
                        <TextBlock x:Name="LatestVer" Text="checking..." Foreground="{StaticResource TextBrush}" FontSize="12.5" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateBadge" Text="" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" FontSize="12.5" FontWeight="SemiBold" Visibility="Collapsed"/>
                </Grid>

                <!-- News / patch notes -->
                <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,0"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25CF;" Foreground="{StaticResource AccentBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="What's new" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="NewsHeading" Text="Loading latest release..." HorizontalAlignment="Right"
                                       Foreground="{StaticResource AccentBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer x:Name="NewsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True" Margin="0,10,4,0" Padding="0,0,6,0">
                            <TextBlock x:Name="NewsBody" Text="Fetching patch notes from GitHub..."
                                       Foreground="{StaticResource SubtleTextBrush}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer actions -->
            <Grid Grid.Row="3" Margin="30,10,30,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Progress + status: pinned above the buttons, always visible -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Border Height="8" CornerRadius="4" Background="{StaticResource TrackBrush}"/>
                    <Border x:Name="ProgressFill" Height="8" CornerRadius="4" HorizontalAlignment="Left" Width="0"
                            Background="{StaticResource AccentBrush}"/>
                </Grid>
                <TextBlock x:Name="StatusLine" Grid.Row="1" Text="" Foreground="{StaticResource SubtleTextBrush}"
                           FontSize="12.5" Margin="2,8,0,14" TextWrapping="Wrap"/>

                <!-- top row: play + shortcut on the left, install/update on the right -->
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="PlayBtn" Style="{StaticResource PrimaryButton}" MinWidth="120" IsEnabled="False" Click="Play_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 0,0 L 10,6 L 0,12 Z" Fill="#FF14181F" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock x:Name="PlayText" Text="Play" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ShortcutBtn" Content="Desktop shortcut" Style="{StaticResource GhostButton}"
                                Margin="10,0,0,0" Click="Shortcut_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CoopToggleBtn" Content="Disable Co-op Mod" Style="{StaticResource GhostButton}" Margin="0,0,10,0" Click="ToggleCoop_Click"/>
                        <Button x:Name="InstallBtn" Content="Install" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="Install_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <CheckBox x:Name="AutoUpdateChk" Content="Automatically install updates on launch"
                                  Foreground="{StaticResource SubtleTextBrush}" IsChecked="True" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Text="Made by Miksy" Foreground="{StaticResource SubtleTextBrush}" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="20,0,0,0" Opacity="0.8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="GitHubBtn" Style="{StaticResource GhostButton}" Padding="12,7" Margin="0,0,8,0" Click="GitHub_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2B25;" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="GitHub" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DiscordBtn" Style="{StaticResource GhostButton}"
                                Padding="12,7" Click="Discord_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x25CF;" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="Discord" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
