<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Friendly Windows file metadata. -->
    <AssemblyName>DeadCellsModLauncher</AssemblyName>
    <ApplicationTitle>Dead Cells Mod Launcher</ApplicationTitle>
    <Product>Dead Cells Mod Launcher</Product>
    <Description>Installer, updater and launcher for the Dead Cells Multiplayer Mod.</Description>
    <Company>Miksy</Company>
    <Authors>Miksy</Authors>
    <Copyright>Copyright © Miksy</Copyright>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <!--
      Public build: one self-contained Windows EXE.
      Compression stays disabled. Native runtime libraries are bundled so
      players do not need a separate .NET installation or a DLL folder.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- More stable/reproducible CI output. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="appicon.ico" />
    <Resource Include="flame.png" />
    <Resource Include="logo.png" />
  </ItemGroup>

</Project>
