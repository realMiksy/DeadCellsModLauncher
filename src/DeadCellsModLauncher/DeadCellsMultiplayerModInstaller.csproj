<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DeadCellsMultiplayerMod Installer</AssemblyName>
    <ApplicationTitle>DeadCellsMultiplayerMod Installer</ApplicationTitle>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <Version>1.0.0</Version>

    <!-- Ship as one self-contained .exe so users need nothing preinstalled. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>


  <ItemGroup>
    <Resource Include="appicon.ico" />
    <Resource Include="flame.png" />
    <Resource Include="logo.png" />
  </ItemGroup>

</Project>
